# =========================================================================
# Nginx Reverse Proxy Configuration Example for https://lincedin.ketware.com
# Sunucuda /etc/nginx/sites-available/lincedin.ketware.com olarak kaydedin.
# =========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name lincedin.ketware.com;

    # HTTP'den HTTPS'e otomatik yönlendirme
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name lincedin.ketware.com;

    # SSL Sertifika yolları (Certbot / Let's Encrypt örneği)
    # ssl_certificate /etc/letsencrypt/live/lincedin.ketware.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/lincedin.ketware.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 1. SignalR WebSockets Endpoint (/gamehub)
    location /gamehub {
        proxy_pass http://127.0.0.1:39470;
        
        # WebSockets için zorunlu başlıklar
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Proxy & Client IP Başlıkları
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket zaman aşımı korumaları
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_cache_bypass $http_upgrade;
    }

    # 2. Web API & Statik React Frontend (Root /)
    location / {
        proxy_pass http://127.0.0.1:39470;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 10M;
    }
}
