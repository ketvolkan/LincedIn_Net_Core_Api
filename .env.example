# ==========================================
# LinçedIn - Environment Configuration Template
# Kopyalayıp .env olarak kaydedin ve şifrelerinizi belirleyin:
# cp .env.example .env
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=linkedin_boss_battle_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongSecretPasswordHere!
POSTGRES_EXTERNAL_PORT=39472

# Application Port (Port exposed on the host)
APP_PORT=39470

# Application Production URL (Used for CORS and reverse proxy)
APP_URL=https://lincedin.ketware.com
ALLOWED_ORIGINS=https://lincedin.ketware.com,http://localhost:39470,http://localhost:5173

# Admin User Credentials (Kendi güçlü şifrenizi belirleyin)
ADMIN_USERNAME=ketware
ADMIN_PASSWORD=YourAdminSecretPassword!
ADMIN_JWT_SECRET=YourSuperSecretJwtKeyMinimum32CharsLong!

# Cloudflare Turnstile Captcha
TURNSTILE_SECRET_KEY=YourTurnstileSecretKeyHere
VITE_TURNSTILE_SITE_KEY=YourTurnstileSiteKeyHere
